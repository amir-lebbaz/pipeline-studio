<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spectral_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Top Header: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_inactive"
                android:clickable="true"
                android:contentDescription="@string/btn_back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Pipeline.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_screen_title"
                    android:textColor="@color/midnight_ink"
                    android:textSize="18sp" />

                <TextView
                    style="@style/TextAppearance.Pipeline.HeroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_screen_subtitle"
                    android:textColor="@color/stormy_slate"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1. Hero Card (#242D36) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bento_gap"
            android:background="@drawable/bg_bento_dark"
            android:orientation="vertical"
            android:padding="@dimen/bento_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Pipeline.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/spectral_white"
                    android:textSize="20sp" />

                <TextView
                    style="@style/TextAppearance.Pipeline.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="v1.1"
                    android:textColor="@color/midnight_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Pipeline.HeroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/spectral_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2. Developer Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bento_gap"
            android:background="@drawable/bg_bento_light"
            android:orientation="vertical"
            android:padding="@dimen/bento_card_padding">

            <TextView
                style="@style/TextAppearance.Pipeline.HeroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_dev_heading"
                android:textColor="@color/stormy_slate"
                android:textSize="12sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_dev_name"
                android:textColor="@color/midnight_ink"
                android:textSize="18sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/about_dev_role"
                android:textColor="@color/stormy_slate"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/silver_fog" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_dev_univ"
                android:textColor="@color/midnight_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/about_dev_dept"
                android:textColor="@color/stormy_slate"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Course Context Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bento_gap"
            android:background="@drawable/bg_bento_light"
            android:orientation="vertical"
            android:padding="@dimen/bento_card_padding">

            <TextView
                style="@style/TextAppearance.Pipeline.HeroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_academic_heading"
                android:textColor="@color/stormy_slate"
                android:textSize="12sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_academic_course"
                android:textColor="@color/midnight_ink"
                android:textSize="16sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/about_academic_desc"
                android:textColor="@color/text_primary_light"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. Specifications Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bento_gap"
            android:background="@drawable/bg_bento_light"
            android:orientation="vertical"
            android:padding="@dimen/bento_card_padding">

            <TextView
                style="@style/TextAppearance.Pipeline.HeroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_specs_heading"
                android:textColor="@color/stormy_slate"
                android:textSize="12sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/about_specs_version"
                android:textColor="@color/midnight_ink"
                android:textSize="13sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_specs_offline"
                android:textColor="@color/midnight_ink"
                android:textSize="13sp" />

            <TextView
                style="@style/TextAppearance.Pipeline.StatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_specs_design"
                android:textColor="@color/midnight_ink"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 5. Action Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- GitHub Repo Button -->
            <TextView
                android:id="@+id/btnOpenGithub"
                style="@style/TextAppearance.Pipeline.Badge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/about_github_btn"
                android:textColor="@color/spectral_white"
                android:textSize="13sp" />

            <!-- Releases Download Button -->
            <TextView
                android:id="@+id/btnOpenReleases"
                style="@style/TextAppearance.Pipeline.Badge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/about_releases_btn"
                android:textColor="@color/midnight_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
